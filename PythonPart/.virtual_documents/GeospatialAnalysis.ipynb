# Time-lapse animated accident map (folium + TimestampedGeoJson)
import folium
from folium.plugins import TimestampedGeoJson
import pandas as pd
import numpy as np

# ========== Settings ==========
# Choose granularity: 'day', 'month', or 'year'
time_granularity = 'month'   # options: 'day', 'month', 'year'

# Maximum number of points to include for performance
max_points = min(800, len(df))

# Color map
color_map = {'Slight': 'green', 'Serious': 'orange', 'Fatal': 'red'}

# ========== Prepare timestamps ==========
# Ensure Accident Date exists and is datetime
if 'Accident Date' in df.columns:
    df['Accident Date'] = pd.to_datetime(df['Accident Date'], errors='coerce')
else:
    # if user has a different column name, this will create NaT and later be filtered out
    df['Accident Date'] = pd.NaT

# If Time exists, combine date + time (preferred)
if 'Time' in df.columns:
    # Normalize time strings and combine where possible
    def combine_date_time(row):
        date = row['Accident Date']
        time = row['Time']
        if pd.isna(date):
            return pd.NaT
        if pd.isna(time):
            return date
        try:
            # try parsing time (handles '08:30' or '8:30', etc.)
            t = pd.to_datetime(str(time), format="%H:%M", errors='coerce')
            if pd.isna(t):
                # fallback: try parsing freeform time
                t = pd.to_datetime(str(time), errors='coerce')
            if pd.isna(t):
                return date
            return pd.Timestamp(
                year=date.year, month=date.month, day=date.day,
                hour=t.hour, minute=t.minute, second=0
            )
        except Exception:
            return date

    df['Accident_Timestamp'] = df.apply(combine_date_time, axis=1)
else:
    df['Accident_Timestamp'] = df['Accident Date']

# Drop rows without coordinates or timestamps
df_t = df.dropna(subset=['Latitude', 'Longitude', 'Accident_Timestamp']).copy()
if df_t.empty:
    raise ValueError("No rows with valid Latitude, Longitude and Accident Date/Time available for the animation.")

# Format timestamps according to granularity
if time_granularity == 'day':
    df_t['time_str'] = df_t['Accident_Timestamp'].dt.strftime('%Y-%m-%dT%H:%M:%S')
    period = 'P1D'
    date_options = 'YYYY-MM-DD'
elif time_granularity == 'month':
    df_t['time_str'] = df_t['Accident_Timestamp'].dt.strftime('%Y-%m')
    period = 'P1M'
    date_options = 'YYYY-MM'
elif time_granularity == 'year':
    df_t['time_str'] = df_t['Accident_Timestamp'].dt.strftime('%Y')
    period = 'P1Y'
    date_options = 'YYYY'
else:
    raise ValueError("time_granularity must be one of: 'day','month','year'")

# Sample for performance (keeps earliest points by timestamp sampling)
#df_t = df_t.sort_values('Accident_Timestamp').head(max_points).reset_index(drop=True)

# Take a RANDOM sample of 200 points, then sort them by time
df_t = df_t.sample(n=max_points, random_state=42).sort_values('Accident_Timestamp').reset_index(drop=True)

# ========== Build GeoJSON features ==========
features = []
for idx, row in df_t.iterrows():
    lat = float(row['Latitude'])
    lon = float(row['Longitude'])
    time = str(row['time_str'])
    severity = str(row.get('Accident_Severity', 'Unknown'))
    weather = str(row.get('Weather_Conditions', 'Unknown'))
    light = str(row.get('Light_Conditions', 'Unknown'))

    color = color_map.get(severity, 'blue')

    feat = {
        "type": "Feature",
        "geometry": {
            "type": "Point",
            "coordinates": [lon, lat],
        },
        "properties": {
            "time": time,
            "style": {"color": color},
            "icon": "circle",
           "popup": f"Severity: {severity}<br>Date: {time}<br>Weather: {weather}<br>Light: {light}"
        }
    }
    features.append(feat)

# ========== Create Map & Add TimestampedGeoJson ==========
m = folium.Map(location=[df['Latitude'].mean(), df['Longitude'].mean()], zoom_start=6,tiles="CartoDB positron")

TimestampedGeoJson(
    {"type": "FeatureCollection", "features": features},
    period=period,
    add_last_point=True,
    auto_play=True,      # set True for auto-play
    loop=False,
    max_speed=1,
    loop_button=True,
    date_options=date_options,
    time_slider_drag_update=True
).add_to(m)

legend_html = """
<div style="
    position: fixed;
    bottom: 50px;
    left: 50px;
    width: 150px;
    padding: 8px;
    background-color: white;
    border: 1px solid grey;
    z-index:9999;
    font-size:12px;
    ">
<b>Severity</b><br>
<span style="display:inline-block;width:12px;height:12px;background:green;margin-right:6px;"></span>Slight<br>
<span style="display:inline-block;width:12px;height:12px;background:orange;margin-right:6px;"></span>Serious<br>
<span style="display:inline-block;width:12px;height:12px;background:red;margin-right:6px;"></span>Fatal
</div>
"""
m.get_root().html.add_child(folium.Element(legend_html))

m



m.save("accident_animation.html")







